{
  "name": "@sudoplatform/sudo-common",
  "version": "0.0.0",
  "author": "Anonyome Labs, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudoplatform/sudo-common-js.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "audit-with-suppressions": "true",
    "clean": "rimraf ./docs ./cjs ./lib ./types",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint \"{bin,src,test}/**/*.{ts,tsx}\"",
    "lint:prettier": "prettier -l \"**/*.{js,json,ts,yml}\"",
    "unit-test": "jest test/unit",
    "test": "jest",
    "build": "yarn clean && yarn build:transpile && yarn build:verify && yarn build:doc",
    "build:verify": "yarn audit-with-suppressions && yarn lint && yarn test --coverage",
    "build:transpile": "concurrently \"yarn build:transpile:declarations\" \"yarn build:transpile:cjs\" \"yarn build:transpile:esm\"",
    "build:transpile:cjs": "tsc --project tsconfig.commonjs.json",
    "build:transpile:esm": "tsc",
    "build:transpile:declarations": "tsc --project tsconfig.declarations.json",
    "build:doc": "typedoc --treatWarningsAsErrors --excludePrivate --out docs src/index.ts"
  },
  "main": "./cjs/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "audit-with-suppressions": "bin/yarn-audit-with-suppression.sh",
    "suppress-audit": "bin/suppress-audit.sh"
  },
  "files": [
    "bin",
    "cjs",
    "lib",
    "types"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "asn1js": "^3.0.6",
    "browser-bunyan": "^1.8.0",
    "fflate": "^0.8.3",
    "graphql": "^16.14.2",
    "pkijs": "^3.4.1",
    "tldts": "^7.4.18",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "io-ts": "^2.2.22"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "expect-type": "^1.4.0",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "io-ts-types": "^0.5.19",
    "isomorphic-fetch": "^3.0.0",
    "isomorphic-webcrypto": "^2.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "monocle-ts": "^2.3.13",
    "newtype-ts": "^0.3.5",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-mockito": "^2.6.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "fast-xml-parser": "^5.11.2",
    "shell-quote": "^1.11.0",
    "http-cache-semantics": "^4.3.0",
    "ip-address": "^10.7.4",
    "markdown-it": "^14.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
